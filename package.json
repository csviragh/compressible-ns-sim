{
  "name": "compressible-ns-sim",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive 2D compressible Navier-Stokes simulator (finite volume, Lamé viscous stress) in the browser",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gpucheck": "node scripts/gpucheck.mjs"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74",
    "puppeteer-core": "^24.43.1",
    "typescript": "~5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "three": "^0.186.1"
  }
}
